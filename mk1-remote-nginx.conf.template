server {
    listen WG_BIND_ADDRESS:8443 ssl;
    server_name RP_DOMAIN;

    ssl_protocols TLSv1.3;
    ssl_conf_command Ciphersuites TLS_AES_256_GCM_SHA384;
    ssl_conf_command Groups X25519MLKEM768;
    ssl_certificate /etc/mk1ai/fullchain.pem;
    ssl_certificate_key /etc/mk1ai/privkey.pem;
    ssl_session_tickets off;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        client_max_body_size 64k;
        proxy_request_buffering on;
        proxy_buffering off;
    }
}
